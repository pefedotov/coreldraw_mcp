<UserControl x:Class="CorelMcp.DockerUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="300" MinHeight="300">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="CorelDRAW MCP Server" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>

    <Grid Grid.Row="1" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Status:" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <TextBlock x:Name="StatusText" Grid.Column="1" Text="unknown" VerticalAlignment="Center"/>
    </Grid>

    <Grid Grid.Row="2" Margin="0,0,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Endpoint:" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <TextBox x:Name="EndpointText" Grid.Column="1" IsReadOnly="True" BorderThickness="0" Background="Transparent"/>
    </Grid>

    <!-- First-run guidance: the panel is where a new user lands, so it has to say what to do
         with the endpoint instead of assuming the README was read. -->
    <TextBlock x:Name="HintText" Grid.Row="3" Margin="0,0,0,8" TextWrapping="Wrap"
               Foreground="#595959" FontSize="11"
               Text="Paste this URL into your MCP client, or press Copy config to put a ready-to-paste JSON block on the clipboard."/>

    <WrapPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,6">
      <Button x:Name="StartButton" Content="Start" Width="64" Margin="0,0,6,4" Click="OnStart"/>
      <Button x:Name="StopButton" Content="Stop" Width="64" Margin="0,0,6,4" Click="OnStop"/>
      <Button x:Name="CopyButton" Content="Copy config" Width="90" Margin="0,0,6,4" Click="OnCopyConfig"/>
      <Button x:Name="ToolsButton" Content="Tools" Width="60" Margin="0,0,6,4" Click="OnTools"/>
      <Button x:Name="DocsButton" Content="Docs" Width="60" Margin="0,0,0,4" Click="OnDocs"/>
    </WrapPanel>

    <GroupBox Grid.Row="5" Header="Log">
      <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
    </GroupBox>
  </Grid>
</UserControl>
